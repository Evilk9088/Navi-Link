<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/window_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToOutline="true"
        android:background="@drawable/bg_floating_dark">

        <!-- ============ 速度区：约占整窗一半高度 ============ -->
        <LinearLayout
            android:id="@+id/ll_panel_speed"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tv_panel_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_panel_speed_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="km/h"
                    android:textColor="#FF9E9E9E"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:background="#12FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_panel_cruise_road"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="无名道路"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp" />

                <com.navi.link.view.CameraWarningView
                    android:id="@+id/ll_panel_cruise_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_traffic_light_capsule"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/v_panel_cruise_divider_top"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#12FFFFFF" />

        <!-- ============ 红绿灯独立一行（无灯时整行隐藏） ============ -->
        <LinearLayout
            android:id="@+id/ll_panel_cruise_lights"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone" />

        <View
            android:id="@+id/v_panel_cruise_light_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#12FFFFFF"
            android:visibility="gone" />

        <!-- 车道线（有数据时才占位） -->
        <com.navi.link.view.LaneLineView
            android:id="@+id/lane_line_view_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
