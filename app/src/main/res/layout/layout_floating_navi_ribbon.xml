<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/window_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToOutline="true"
        android:background="@drawable/bg_floating_dark">

        <!-- 主行：左色块 + 右侧信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:orientation="horizontal">

            <!-- 左侧实心色块（主题色，圆角只做左侧，与窗口外框贴合） -->
            <LinearLayout
                android:id="@+id/ll_ribbon_left"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_ribbon_left">

                <ImageView
                    android:id="@+id/iv_ribbon_turn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/sou4_night_a530" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tv_ribbon_dist_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="283"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ribbon_dist_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:maxLines="1"
                        android:text="米"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右侧信息区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_ribbon_road"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="居里夫人大道"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- 当前红绿灯倒计时角标 -->
                    <LinearLayout
                        android:id="@+id/layout_ribbon_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <View
                            android:id="@+id/v_ribbon_light_dot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_circle_white" />

                        <TextView
                            android:id="@+id/tv_ribbon_light_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="8s"
                            android:textColor="#FFE0E0E0"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_ribbon_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="2.4公里 · 8分钟 · 18:06到"
                    android:textColor="#FFA0A0A0"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 车道线（有数据时才占位） -->
        <com.navi.link.view.LaneLineView
            android:id="@+id/lane_line_view_ribbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- 区间测速（仅在区间测速路段出现） -->
        <com.navi.link.view.IntervalSpeedView
            android:id="@+id/interval_speed_view_ribbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- 底部 TMC 细条 -->
        <com.navi.link.view.TmcProgressBar
            android:id="@+id/tmc_progress_bar_ribbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
